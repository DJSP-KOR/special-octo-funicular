// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Source {
  NAVER
  REUTERS
}

model Keyword {
  id          String    @id @default(cuid())
  ownerId     String
  text        String
  searchQuery String?
  createdAt   DateTime  @default(now())
  articles    Article[]

  @@unique([ownerId, text])
}

model Article {
  id          String   @id @default(cuid())
  source      Source
  title       String
  url         String   @unique
  description String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  keywords    Keyword[]

  @@index([publishedAt])
}
